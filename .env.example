# 기본 demo는 환경변수와 API 키를 사용하지 않습니다.
# 실제 평가: 아래 변수를 환경에 export하세요. CLI는 .env를 자동 로드하지 않습니다.
QWEN_MODEL=Qwen/Qwen3-4B
QWEN_DEVICE=auto
QWEN_REVISION=main
# 1차 출처로 확인한 호스트만 쉼표로 지정 (공란이면 arxiv 외 출처는 간접 자료 취급)
OFFICIAL_SOURCE_DOMAINS=
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=kv-cache-eval
