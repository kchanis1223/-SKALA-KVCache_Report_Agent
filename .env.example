# 필수: 모든 에이전트가 같은 OpenAI 모델을 쓰고 역할별 추론 강도만 다릅니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# 필수: worker의 web_search 도구
TAVILY_API_KEY=
# 공식 자료로 분류할 도메인 (쉼표 구분)
OFFICIAL_SOURCE_DOMAINS=

# 선택: worker의 paper_search 도구와 오케스트레이터의 기술 개요에 쓰는 논문 색인.
# 없으면 논문 검색 없이 웹 근거로만 진행하고 보고서에 그 사실을 남깁니다.
RAG_INDEX_DIR=index/bge-m3

# 선택: LangSmith 추적. true면 metadata의 run_id로 보고서와 추적을 연결합니다.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kv-cache-eval

# (선택) PDF 보고서 한글 글꼴(.ttf). 비우면 macOS AppleGothic, NanumGothic 순으로 찾습니다.
REPORT_FONT=
