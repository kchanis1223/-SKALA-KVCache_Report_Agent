# 기본 경로: 아홉 Agent 모두 OpenAI 단일 모델을 사용하고 추론 강도로만 구분합니다.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 조직 배포명이 다르면 코드를 고치지 않고 여기서 바꿉니다.
OPENAI_MODEL=gpt-5.4-mini

# 오프라인 재현·비교 실행용 로컬 경로. LLM_PROVIDER=ollama로 전환합니다.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120
LIGHT_MODEL=qwen3:4b
MAIN_MODEL=qwen3:4b

# true이면 Synthesis·Report에 전용 모델 객체를 두지 않습니다(저사양 환경).
USE_SINGLE_MODEL=false

# real 모드에서 자동 연결할 논문 색인. 없으면 RAG 미연결을 결과에 명시합니다.
RAG_INDEX_DIR=index/bge-m3

# 실시간 웹검색에는 Tavily 키가 필요합니다.
TAVILY_API_KEY=
OFFICIAL_SOURCE_DOMAINS=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kv-cache-eval
