LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120

LIGHT_MODEL=qwen3:4b

# Research·Additional Search·TRL·Market·Stakeholder·Domain은 Qwen3-4B/Ollama를 사용합니다.
# 저사양 환경: true이면 모든 Agent를 4B 하나에 배정합니다.
USE_SINGLE_MODEL=false
SINGLE_MODEL=qwen3:4b

# real mode의 Synthesis는 GPT-5.6 Sol, Validation·Report는 GPT-5.6 Terra를 사용합니다.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# real 모드에서 자동 연결할 논문 색인. 없으면 RAG 미연결을 결과에 명시합니다.
RAG_INDEX_DIR=index/bge-m3

# 실시간 웹검색에는 Tavily 키가 필요합니다.
TAVILY_API_KEY=
OFFICIAL_SOURCE_DOMAINS=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kv-cache-eval
